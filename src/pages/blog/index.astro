---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { PostListItem } from "@/components/PostListItem";
import { getCollection } from "astro:content";
import { extractPagePreview } from "@/lib/pagePreview";
import { filterEntriesByLang } from "@/lib/content";
import { formatDate } from "@/i18n/ui";

const allPosts = await getCollection("blog");
const sortedPosts = filterEntriesByLang(allPosts, "ko")
  .filter(({ entry }) => !entry.data.draft)
  .sort((a, b) => b.entry.data.pubDate.getTime() - a.entry.data.pubDate.getTime());
---

<BaseLayout
  title="블로그 | Segyun"
  description="기술 블로그"
  lang="ko"
>
  <div class="space-y-8">
    <div class="space-y-2">
      <h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl">블로그</h1>
    </div>

    <!-- Posts List -->
    <div class="divide-y divide-border pt-2">
      {sortedPosts.map(({ baseSlug, entry }) => {
        const thumbnailSrc =
          typeof entry.data.thumbnail === "object"
            ? entry.data.thumbnail?.src
            : entry.data.thumbnail;

        return (
          <PostListItem
            title={entry.data.title}
            description={entry.data.description}
            date={formatDate(entry.data.pubDate, "ko")}
            slug={baseSlug}
            thumbnail={thumbnailSrc}
            preview={extractPagePreview(entry.body || "")}
          />
        );
      })}
    </div>
  </div>
</BaseLayout>
