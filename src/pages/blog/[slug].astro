---
import { getCollection } from "astro:content";
import { filterEntriesByLang } from "@/lib/content";
import BlogPostView from "@/views/BlogPostView.astro";

export async function getStaticPaths() {
  const allPosts = await getCollection("blog");
  const koPosts = filterEntriesByLang(allPosts, "ko");
  return koPosts.map(({ baseSlug, entry }) => ({
    params: { slug: baseSlug },
    props: { post: entry },
  }));
}

const { post } = Astro.props;
---

<BlogPostView post={post} lang="ko" />
