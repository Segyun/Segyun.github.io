---
import { getCollection } from "astro:content";
import { filterEntriesByLang } from "@/lib/content";
import ProjectDetailView from "@/views/ProjectDetailView.astro";

export async function getStaticPaths() {
  const allProjects = await getCollection("projects");
  const koProjects = filterEntriesByLang(
    allProjects.filter((project) => project.id.includes("/")),
    "ko"
  );

  return koProjects.map(({ baseSlug, entry }) => ({
    params: { slug: baseSlug },
    props: { project: entry },
  }));
}

const { project } = Astro.props;
---

<ProjectDetailView project={project} lang="ko" />
