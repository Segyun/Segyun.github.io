---
import BaseLayout from "@/layouts/BaseLayout.astro";
import MarkdownEnhancer from "@/components/MarkdownEnhancer.astro";
import { getCollection, render } from "astro:content";

const aboutEntries = await getCollection("about");
const aboutEntry =
  aboutEntries.find((entry) => entry.id === "indexen" || entry.id === "index.en") ||
  aboutEntries.find((entry) => entry.id === "index");

if (!aboutEntry) {
  throw new Error("About content not found in src/content/about");
}

const { Content } = await render(aboutEntry);
---

<BaseLayout
  title={aboutEntry.data.title}
  description={aboutEntry.data.description}
  lang="en"
>
  <article class="max-w-3xl mx-auto space-y-8">
    <div class="markdown-body space-y-4 leading-relaxed text-foreground [&_h1]:text-3xl [&_h1]:font-extrabold [&_h1]:tracking-tight sm:[&_h1]:text-4xl [&_h1]:mb-6 [&_h2]:text-2xl [&_h2]:font-bold [&_h2]:tracking-tight [&_h2]:mt-10 [&_h2]:mb-4 [&_h3]:text-lg [&_h3]:font-semibold [&_h3]:mt-6 [&_h3]:mb-2 [&_p]:leading-7 [&_ul]:list-disc [&_ul]:pl-6 [&_ol]:list-decimal [&_ol]:pl-6 [&_li]:mt-1.5 [&_hr]:my-8 [&_hr]:border-border [&_a]:text-primary [&_a]:underline [&_a]:underline-offset-4 [&_a]:hover:opacity-80">
      <Content />
    </div>
  </article>

  <MarkdownEnhancer />
</BaseLayout>
