---
const currentYear = new Date().getFullYear();
---

<footer class="w-full border-t border-border py-8 text-sm text-muted-foreground">
  <div class="mx-auto flex max-w-4xl flex-col items-center justify-between gap-4 px-4 sm:flex-row">
    <div>
      <p>© {currentYear} Huigyun Jeong (Segyun). All rights reserved.</p>
    </div>

    <div class="flex items-center gap-4">
      <a
        href="https://github.com/Segyun"
        target="_blank"
        rel="noreferrer"
        class="hover:text-foreground transition-colors"
      >
        GitHub
      </a>
    </div>
  </div>
</footer>
