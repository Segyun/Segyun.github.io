<script>
  const COPY_ICON = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>`;
  const CHECK_ICON = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>`;
  const CODE_ICON = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>`;
  const DIAGRAM_ICON = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="8" height="8" x="3" y="3" rx="2"/><path d="M7 11v4a2 2 0 0 0 2 2h4"/><rect width="8" height="8" x="13" y="13" rx="2"/></svg>`;

  function setupCodeCopyButtons() {
    const codeBlocks = document.querySelectorAll('.markdown-body pre');
    codeBlocks.forEach((pre) => {
      if (pre.closest('.mermaid-block')) return;
      if (pre.querySelector('.copy-code-btn')) return;

      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'copy-code-btn';
      button.setAttribute('aria-label', '코드 복사');
      button.setAttribute('title', '코드 복사');
      button.innerHTML = COPY_ICON;

      button.addEventListener('click', async (e) => {
        e.stopPropagation();
        const codeEl = pre.querySelector('code');
        const textToCopy = codeEl ? codeEl.innerText : pre.innerText;

        try {
          await navigator.clipboard.writeText(textToCopy.trim());
          button.classList.add('copied');
          button.innerHTML = CHECK_ICON;
          setTimeout(() => {
            button.classList.remove('copied');
            button.innerHTML = COPY_ICON;
          }, 2000);
        } catch (err) {
          console.error('Failed to copy code:', err);
        }
      });

      pre.appendChild(button);
    });
  }

  function setupMermaidControls() {
    const blocks = document.querySelectorAll('.mermaid-block');
    blocks.forEach((block) => {
      if ((block as HTMLElement).dataset.initialized === 'true') return;
      (block as HTMLElement).dataset.initialized = 'true';

      const toggleBtn = block.querySelector<HTMLButtonElement>('.mermaid-view-toggle-btn');
      const previewPanel = block.querySelector<HTMLElement>('.mermaid-preview-panel');
      const codePanel = block.querySelector<HTMLElement>('.mermaid-code-panel');
      const copyBtn = block.querySelector<HTMLButtonElement>('.mermaid-copy-btn');
      const diagramCode = block.getAttribute('data-diagram') || '';

      if (toggleBtn && previewPanel && codePanel) {
        let isCodeView = false;
        toggleBtn.addEventListener('click', () => {
          isCodeView = !isCodeView;
          if (isCodeView) {
            previewPanel.classList.add('hidden');
            codePanel.classList.remove('hidden');
            toggleBtn.innerHTML = DIAGRAM_ICON;
            toggleBtn.setAttribute('title', '다이어그램 보기');
            toggleBtn.setAttribute('aria-label', '다이어그램 보기');
          } else {
            codePanel.classList.add('hidden');
            previewPanel.classList.remove('hidden');
            toggleBtn.innerHTML = CODE_ICON;
            toggleBtn.setAttribute('title', '코드 보기');
            toggleBtn.setAttribute('aria-label', '코드 보기');
          }
        });
      }

      if (copyBtn) {
        copyBtn.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(diagramCode);
            copyBtn.classList.add('copied');
            copyBtn.innerHTML = CHECK_ICON;
            setTimeout(() => {
              copyBtn.classList.remove('copied');
              copyBtn.innerHTML = COPY_ICON;
            }, 2000);
          } catch (err) {
            console.error('Failed to copy diagram code:', err);
          }
        });
      }
    });
  }

  async function renderMermaid() {
    const diagrams = document.querySelectorAll('.mermaid');
    if (diagrams.length === 0) return;

    const { default: mermaid } = await import('mermaid');
    const isDark =
      document.documentElement.classList.contains('dark') ||
      window.matchMedia('(prefers-color-scheme: dark)').matches;

    mermaid.initialize({
      startOnLoad: false,
      theme: isDark ? 'dark' : 'default',
      themeVariables: {
        background: 'transparent',
        darkMode: isDark,
      },
      securityLevel: 'loose',
      fontFamily: '"JetBrains Mono", monospace',
    });

    for (let i = 0; i < diagrams.length; i++) {
      const el = diagrams[i] as HTMLElement;
      const code = el.getAttribute('data-diagram') || el.textContent || '';
      try {
        const id = `mermaid-svg-${i}-${Date.now()}`;
        const { svg } = await mermaid.render(id, code);
        el.innerHTML = svg;
      } catch (err) {
        console.error('Mermaid rendering failed:', err);
      }
    }
  }

  function initPageEnhancements() {
    setupCodeCopyButtons();
    setupMermaidControls();
    renderMermaid();
  }

  initPageEnhancements();

  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
    renderMermaid();
  });

  const themeObserver = new MutationObserver((mutations) => {
    for (const mutation of mutations) {
      if (mutation.type === 'attributes' && mutation.attributeName === 'class') {
        renderMermaid();
        break;
      }
    }
  });
  themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });

  document.addEventListener('astro:after-swap', initPageEnhancements);
</script>
