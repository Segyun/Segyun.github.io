---
import { buttonVariants } from "@/components/ui/button";
import { cn } from "@/lib/utils";
import type { Lang } from "@/i18n/ui";
import { useTranslations } from "@/i18n/ui";
import { getCurrentLocale, getLocalizedPath, getSwitchLocaleUrl } from "@/i18n/utils";
import { Globe } from "lucide-react";

interface Props {
  currentLocale?: Lang;
}

const currentPath = Astro.url.pathname;
const locale = Astro.props.currentLocale ?? getCurrentLocale(currentPath);
const t = useTranslations(locale);

const homeUrl = getLocalizedPath("/", locale);

const navItems = [
  { label: t("nav.home"), href: getLocalizedPath("/", locale) },
  { label: t("nav.blog"), href: getLocalizedPath("/blog", locale) },
  { label: t("nav.projects"), href: getLocalizedPath("/projects", locale) },
  { label: t("nav.about"), href: getLocalizedPath("/about", locale) },
];

const targetLocale: Lang = locale === "ko" ? "en" : "ko";
const switchUrl = getSwitchLocaleUrl(currentPath, targetLocale);
---

<header class="sticky top-0 z-50 w-full border-b border-border bg-background/80 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-4xl items-center justify-between px-4">
    <!-- Brand / Name -->
    <a href={homeUrl} class="font-mono font-bold text-lg tracking-tight hover:text-primary transition-colors">
      Segyun
    </a>

    <!-- Right Actions: Desktop Nav + Language Switcher + Mobile Button -->
    <div class="flex items-center gap-4 md:gap-6">
      <!-- Desktop Navigation -->
      <nav class="hidden md:flex items-center gap-6 text-sm font-medium">
        {navItems.map((item) => {
          const isActive = item.href === homeUrl ? currentPath === homeUrl : currentPath.startsWith(item.href);
          return (
            <a
              href={item.href}
              class:list={[
                "transition-colors hover:text-primary",
                isActive ? "text-primary font-semibold" : "text-muted-foreground",
              ]}
            >
              {item.label}
            </a>
          );
        })}
      </nav>

      <!-- Language Switcher -->
      <a
        href={switchUrl}
        class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-mono font-medium border border-border text-muted-foreground hover:text-foreground hover:bg-muted transition-colors focus:outline-none focus:ring-2 focus:ring-ring"
        aria-label={locale === "ko" ? "Switch to English" : "한국어로 전환"}
        title={locale === "ko" ? "English" : "한국어"}
      >
        <Globe className="h-3.5 w-3.5" />
        <span>{locale === "ko" ? "EN" : "KO"}</span>
      </a>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-btn"
        type="button"
        class={cn(buttonVariants({ variant: "outline", size: "icon" }), "md:hidden")}
        aria-label="Open mobile menu"
      >
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Navigation Drawer -->
  <div id="mobile-menu" class="hidden border-b border-border bg-background px-4 py-3 md:hidden">
    <nav class="flex flex-col space-y-3 text-sm font-medium">
      {navItems.map((item) => {
        const isActive = item.href === homeUrl ? currentPath === homeUrl : currentPath.startsWith(item.href);
        return (
          <a
            href={item.href}
            class:list={[
              "py-1 transition-colors hover:text-primary",
              isActive ? "text-primary font-semibold" : "text-muted-foreground",
            ]}
          >
            {item.label}
          </a>
        );
      })}
    </nav>
  </div>
</header>

<script>
  function setupMobileMenu() {
    const btn = document.getElementById("mobile-menu-btn");
    const menu = document.getElementById("mobile-menu");
    if (!btn || !menu) return;

    btn.addEventListener("click", () => {
      menu.classList.toggle("hidden");
    });
  }

  setupMobileMenu();
  document.addEventListener("astro:after-swap", setupMobileMenu);
</script>
