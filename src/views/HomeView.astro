---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { ProjectListItem } from "@/components/ProjectListItem";
import { PostListItem } from "@/components/PostListItem";
import { getCollection } from "astro:content";
import { extractPagePreview } from "@/lib/pagePreview";
import InteractiveSpotlight from "@/components/InteractiveSpotlight.astro";
import { ArrowRight } from "lucide-react";
import { filterEntriesByLang } from "@/lib/content";
import { useTranslations, formatDate, type Lang } from "@/i18n/ui";
import { getLocalizedPath } from "@/i18n/utils";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const HOME_PROJECT_SLUGS: string[] = [
  "package/fluid-header",
  "package/over-keyboard",
  "package/text-transition",
  "package/tubelight",
];

const allProjects = await getCollection("projects");
const localizedProjects = filterEntriesByLang(allProjects, lang);
let homeProjects = HOME_PROJECT_SLUGS
  .map((slug) => localizedProjects.find((p) => p.baseSlug === slug))
  .filter((p): p is NonNullable<typeof p> => p !== undefined);

if (homeProjects.length === 0 && localizedProjects.length > 0) {
  homeProjects = localizedProjects.slice(0, 4);
}

const allPosts = await getCollection("blog");
const recentPosts = filterEntriesByLang(allPosts, lang)
  .filter(({ entry }) => !entry.data.draft)
  .sort((a, b) => b.entry.data.pubDate.getTime() - a.entry.data.pubDate.getTime())
  .slice(0, 3);

const blogUrl = getLocalizedPath("/blog", lang);
const projectsUrl = getLocalizedPath("/projects", lang);
---

<BaseLayout
  title="Segyun"
  lang={lang}
>
  <div class="space-y-12">
    <!-- Interactive Spotlight Element -->
    <InteractiveSpotlight />

    <!-- Recent Blog Posts Section -->
    <section class="space-y-6">
      <div class="flex items-center justify-between">
        <h2 class="text-2xl font-bold tracking-tight">{t("home.blog_title")}</h2>
        <a
          href={blogUrl}
          class="inline-flex items-center gap-1 text-sm font-medium text-muted-foreground hover:text-primary transition-colors"
        >
          <span>{t("home.view_all")}</span>
          <ArrowRight className="h-4 w-4" />
        </a>
      </div>

      {recentPosts.length === 0 ? (
        <div class="py-6 text-sm text-muted-foreground">
          {t("blog.empty")}
        </div>
      ) : (
        <div class="divide-y divide-border">
          {recentPosts.map(({ baseSlug, entry }) => {
            const thumbnailSrc =
              typeof entry.data.thumbnail === "object"
                ? entry.data.thumbnail?.src
                : entry.data.thumbnail;

            return (
              <PostListItem
                title={entry.data.title}
                description={entry.data.description}
                date={formatDate(entry.data.pubDate, lang)}
                slug={baseSlug}
                basePath={blogUrl}
                thumbnail={thumbnailSrc}
                preview={extractPagePreview(entry.body || "")}
              />
            );
          })}
        </div>
      )}
    </section>

    <!-- Featured Projects Section -->
    <section class="space-y-6">
      <div class="flex items-center justify-between">
        <h2 class="text-2xl font-bold tracking-tight">{t("home.projects_title")}</h2>
        <a
          href={projectsUrl}
          class="inline-flex items-center gap-1 text-sm font-medium text-muted-foreground hover:text-primary transition-colors"
        >
          <span>{t("home.view_all")}</span>
          <ArrowRight className="h-4 w-4" />
        </a>
      </div>

      {homeProjects.length === 0 ? (
        <div class="py-6 text-sm text-muted-foreground">
          {t("projects.empty")}
        </div>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          {homeProjects.map(({ baseSlug, entry }) => {
            const thumbnailSrc =
              typeof entry.data.thumbnail === "object"
                ? entry.data.thumbnail?.src
                : entry.data.thumbnail;

            return (
              <ProjectListItem
                title={entry.data.title}
                description={entry.data.description}
                slug={baseSlug}
                basePath={projectsUrl}
                githubUrl={entry.data.githubUrl}
                demoUrl={entry.data.demoUrl}
                thumbnail={thumbnailSrc}
              />
            );
          })}
        </div>
      )}
    </section>
  </div>
</BaseLayout>
