---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Separator } from "@/components/ui/separator";
import { render, type CollectionEntry } from "astro:content";
import { ArrowLeft, Calendar } from "lucide-react";
import MarkdownEnhancer from "@/components/MarkdownEnhancer.astro";
import { useTranslations, formatDate, type Lang } from "@/i18n/ui";
import { getLocalizedPath } from "@/i18n/utils";

interface Props {
  post: CollectionEntry<"blog">;
  lang: Lang;
}

const { post, lang } = Astro.props;
const t = useTranslations(lang);
const { Content } = await render(post);
const backUrl = getLocalizedPath("/blog", lang);
---

<BaseLayout
  title={`${post.data.title} | Segyun`}
  description={post.data.description}
  lang={lang}
>
  <article class="space-y-8 max-w-3xl mx-auto">
    <!-- Back button -->
    <div>
      <a
        href={backUrl}
        class="inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-foreground transition-colors"
      >
        <ArrowLeft className="h-4 w-4" />
        <span>{t("blog.back")}</span>
      </a>
    </div>

    <!-- Article Header -->
    <header class="space-y-4">
      <h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl md:text-5xl text-foreground">
        {post.data.title}
      </h1>

      {post.data.description && (
        <p class="text-lg text-muted-foreground leading-relaxed">
          {post.data.description}
        </p>
      )}

      <div class="flex items-center gap-1.5 text-sm text-muted-foreground pt-1">
        <Calendar className="h-4 w-4" />
        <time datetime={post.data.pubDate.toISOString()}>
          {formatDate(post.data.pubDate, lang)}
        </time>
      </div>
    </header>

    <Separator />

    <!-- Article Body -->
    <div class="markdown-body space-y-4 leading-relaxed text-foreground [&_h1]:text-2xl [&_h1]:font-bold [&_h1]:mt-8 [&_h1]:mb-4 [&_h2]:text-xl [&_h2]:font-bold [&_h2]:mt-6 [&_h2]:mb-3 [&_h3]:text-lg [&_h3]:font-semibold [&_h3]:mt-4 [&_h3]:mb-2 [&_p]:leading-7 [&_ul]:list-disc [&_ul]:pl-6 [&_ol]:list-decimal [&_ol]:pl-6 [&_li]:mt-1.5">
      <Content />
    </div>
  </article>

  <MarkdownEnhancer />
</BaseLayout>
