---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { PostListItem } from "@/components/PostListItem";
import { getCollection } from "astro:content";
import { extractPagePreview } from "@/lib/pagePreview";
import { filterEntriesByLang } from "@/lib/content";
import { useTranslations, formatDate, type Lang } from "@/i18n/ui";
import { getLocalizedPath } from "@/i18n/utils";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const allPosts = await getCollection("blog");
const sortedPosts = filterEntriesByLang(allPosts, lang)
  .filter(({ entry }) => !entry.data.draft)
  .sort((a, b) => b.entry.data.pubDate.getTime() - a.entry.data.pubDate.getTime());

const blogUrl = getLocalizedPath("/blog", lang);
---

<BaseLayout
  title={`${t("blog.title")} | Segyun`}
  lang={lang}
>
  <div class="space-y-8">
    <div class="space-y-2">
      <h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl text-foreground">
        {t("blog.title")}
      </h1>
    </div>

    <!-- Posts List -->
    {sortedPosts.length === 0 ? (
      <div class="py-12 text-center text-muted-foreground">
        <p class="text-sm">{t("blog.empty")}</p>
      </div>
    ) : (
      <div class="divide-y divide-border pt-2">
        {sortedPosts.map(({ baseSlug, entry }) => {
          const thumbnailSrc =
            typeof entry.data.thumbnail === "object"
              ? entry.data.thumbnail?.src
              : entry.data.thumbnail;

          return (
            <PostListItem
              title={entry.data.title}
              description={entry.data.description}
              date={formatDate(entry.data.pubDate, lang)}
              slug={baseSlug}
              basePath={blogUrl}
              thumbnail={thumbnailSrc}
              preview={extractPagePreview(entry.body || "")}
            />
          );
        })}
      </div>
    )}
  </div>
</BaseLayout>
